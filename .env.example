# ACTIONLOCK Backend Server Environment (NEVER expose secrets via VITE_ variables)
PORT=8787
NODE_ENV=development

# Database (Local SQLite default for MVP; PostgreSQL URL for production target)
SQLITE_DB_PATH=./data/actionlock.db
DATABASE_URL=

# Session & Scoped Token Security (Set strong random secrets in production)
SESSION_SECRET=
ACTION_TOKEN_SECRET=

# DetectifAI Platform API (https://platform.detectif.ai/docs/)
DETECTIF_API_KEY=your_detectifai_server_api_key_here
DETECTIF_API_BASE_URL=https://platform.detectif.ai
DETECTIF_WEBHOOK_SECRET=whsec_your_base64_webhook_secret_here

# Google Cloud Speech-to-Text V2 (Phase 4)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
STT_LANGUAGE_CODE=en-US

# GitHub App Custom Deployment Protection Rule Adapter (Phase 7)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# WebAuthn / FIDO2 Relying Party Configuration (Phase 6)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ACTIONLOCK Enterprise
WEBAUTHN_ORIGIN=http://localhost:5173
